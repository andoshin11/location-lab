{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Location Lab",
  "version": "0.1.0",
  "identifier": "dev.locationlab.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node scripts/copy-vendor.mjs",
    "beforeBuildCommand": "node scripts/copy-vendor.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Location Lab",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
